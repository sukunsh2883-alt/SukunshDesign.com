    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "meshline": "^3.3.1",
